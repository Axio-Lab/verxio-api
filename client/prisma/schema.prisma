// This file points to the root Prisma schema
// The actual schema is in ../prisma/schema.prisma
// This allows the client to generate Prisma Client from the root schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Minimal schema for client-only deploys.
// Includes only the User model fields used by client webhooks.

model User {
  id                    String    @id @default(cuid())
  subscriptionStatus    String?
  subscriptionPlan      String?
  subscriptionExpiresAt DateTime?
  polarCustomerId       String?
  subscriptionFeatures  String[]
  rateLimitRemaining    Int?
  rateLimitResetAt      DateTime?

  @@map("user")
}

