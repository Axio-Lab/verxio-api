{
  "name": "@verxioprotocol/verxio-api",
  "version": "1.0.0",
  "description": "Verxio Loyalty API Backend Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run db:generate && tsc && npm run copy:guides",
    "copy:guides": "copyfiles -u 1 \"src/services/agent/guides/*\" dist",
    "start": "node -r module-alias/register dist/index.js",
    "start:prod": "npm run db:migrate:deploy && npm run start",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:enable-vector": "prisma db execute --file prisma/scripts/enable-vector.sql --schema prisma/schema.prisma",
    "start:whatsapp-connector": "tsx src/whatsapp-connector/run.ts",
    "start:whatsapp-connector:prod": "node dist/whatsapp-connector/run.js",
    "start:discord-connector": "tsx src/discord-connector/run.ts",
    "start:discord-connector:prod": "node dist/discord-connector/run.js",
    "inngest:dev": "inngest dev",
    "test:support-multichannel-smoke": "tsx src/tests/support-multichannel-smoke.ts"
  },
  "keywords": [
    "verxio",
    "loyalty",
    "api",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.2",
    "@ai-sdk/google": "^3.0.1",
    "@ai-sdk/openai": "^3.0.2",
    "@anthropic-ai/claude-agent-sdk": "^0.2.81",
    "@composio/core": "^0.6.4",
    "@daytonaio/sdk": "^0.129.0",
    "@google/genai": "^1.37.0",
    "@inngest/realtime": "^0.4.5",
    "@metaplex-foundation/umi": "^1.2.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.2.0",
    "@metaplex-foundation/umi-signer-wallet-adapters": "^1.2.0",
    "@metaplex-foundation/umi-web3js-adapters": "^1.2.0",
    "@paralleldrive/cuid2": "^3.0.6",
    "@polar-sh/sdk": "^0.46.4",
    "@prisma/client": "^6.14.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@verxioprotocol/core": "^0.1.3",
    "@xyflow/react": "^12.10.0",
    "ai": "^6.0.3",
    "baileys": "^6.7.21",
    "bcryptjs": "^2.4.3",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "googleapis": "^169.0.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "html-entities": "^2.6.0",
    "inngest": "^3.48.1",
    "ky": "^1.14.2",
    "mammoth": "^1.12.0",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.17.2",
    "pinata": "^2.5.2",
    "prisma-field-encryption": "^1.6.0",
    "resend": "^6.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "toposort": "^2.0.2",
    "tweetnacl": "^1.0.3",
    "valyu-js": "^2.5.9",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.27",
    "@types/pdf-parse": "^1.1.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/toposort": "^2.0.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9",
    "husky": "^9.1.7",
    "inngest-cli": "^1.17.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "prisma": "^6.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "_moduleAliases": {
    "@": "dist"
  }
}
