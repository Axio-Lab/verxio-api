generator client {
  provider = "prisma-client-js"
  output   = "../../client/node_modules/.prisma/client"
}

generator backendClient {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

generator fieldEncryption {
  provider = "prisma-field-encryption"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VerxioUser {
  id                String   @id @default(cuid())
  email             String   @unique
  verxioBalance     Float    @default(0)
  creatorAddress    String?
  /// @encrypted
  creatorPrivateKey String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations:  Links to transactions this user sent or received
  sentTransactions     VerxioTransaction[] @relation("SentTransactions")
  receivedTransactions VerxioTransaction[] @relation("ReceivedTransactions")
  apiKeys              ApiKey[]

  @@index([email])
  @@index([creatorAddress])
  @@map("verxio_users")
}

model VerxioTransaction {
  id          String   @id @default(cuid())
  fromUserId  String? // ID of user who sent (null if admin issued)
  toUserId    String // ID of user who received
  amount      Float
  description String?
  createdAt   DateTime @default(now())

  // Relations: These link the transaction to VerxioUser records
  // fromUser: Links to the VerxioUser who sent (optional because admin can issue)
  fromUser VerxioUser? @relation("SentTransactions", fields: [fromUserId], references: [id])
  // toUser: Links to the VerxioUser who received
  toUser   VerxioUser  @relation("ReceivedTransactions", fields: [toUserId], references: [id])

  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdAt])
  @@map("verxio_transactions")
}

model ApiKey {
  id         String    @id @default(cuid())
  key        String    @unique
  userId     String
  name       String? // Optional name/description for the API key
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  user VerxioUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
  @@index([isActive])
  @@map("api_keys")
}

model LoyaltyProgram {
  id                 String             @id @default(cuid())
  creator            String
  programPublicKey   String
  /// @encrypted
  programSecretKey   String
  signature          String
  metadataUri        String? // Store the metadata URI for reuse when issuing passes
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  authorityPublicKey String
  /// @encrypted
  authoritySecretKey String
  claimLinks         LoyaltyClaimLink[]

  @@index([creator])
  @@index([programPublicKey])
  @@map("loyalty_programs")
}

model LoyaltyProgramClaimStatus {
  id             String   @id @default(cuid())
  programAddress String   @unique
  claimEnabled   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("loyalty_program_claim_status")
}

model LoyaltyPass {
  id                    String   @id @default(cuid())
  loyaltyProgramAddress String
  recipient             String
  loyaltyPassPublicKey  String
  /// @encrypted
  loyaltyPassPrivateKey String
  signature             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([loyaltyProgramAddress])
  @@index([recipient])
  @@index([loyaltyPassPublicKey])
  @@map("loyalty_passes")
}

model VoucherCollection {
  id                  String       @id @default(cuid())
  creator             String
  collectionPublicKey String
  /// @encrypted
  collectionSecretKey String
  signature           String
  metadataUri         String? // Store the metadata URI for reuse when minting vouchers
  authorityPublicKey  String
  /// @encrypted
  authoritySecretKey  String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  vouchers            Voucher[]
  rewardLinks         RewardLink[]

  @@index([creator])
  @@index([collectionPublicKey])
  @@map("voucher_collections")
}

model Voucher {
  id                String            @id @default(cuid())
  collectionId      String
  recipient         String
  voucherPublicKey  String
  /// @encrypted
  voucherPrivateKey String
  signature         String
  worth             Float?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  collection        VoucherCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([recipient])
  @@index([voucherPublicKey])
  @@map("vouchers")
}

model RewardLink {
  id                String    @id @default(cuid())
  creatorEmail      String
  creatorAddress    String
  collectionId      String
  collectionAddress String
  slug              String?   @unique // Deprecated: use claimCode instead
  claimCode         String?   @unique
  voucherType       String
  voucherName       String?
  description       String?
  voucherWorth      Float?
  valueSymbol       String?
  assetName         String?
  assetSymbol       String?
  tokenAddress      String?
  maxUses           Int?
  expiryDate        DateTime?
  transferable      Boolean   @default(false)
  conditions        String?
  metadataUri       String?
  merchantId        String?
  status            String    @default("active")
  voucherAddress    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  collection VoucherCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([creatorEmail])
  @@index([creatorAddress])
  @@index([collectionId])
  @@index([collectionAddress])
  @@index([claimCode])
  @@map("reward_links")
}

model LoyaltyClaimLink {
  id                 String   @id @default(cuid())
  creatorEmail       String
  creatorAddress     String
  programId          String
  programAddress     String
  claimCode          String   @unique
  passName           String?
  organizationName   String?
  description        String?
  metadataUri        String?
  status             String   @default("active")
  loyaltyPassAddress String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([creatorEmail])
  @@index([creatorAddress])
  @@index([programId])
  @@index([programAddress])
  @@index([claimCode])
  @@map("loyalty_claim_links")
}

model Deal {
  id                String    @id @default(cuid())
  creatorEmail      String
  collectionName    String
  category          String?
  tradeable         Boolean   @default(true)
  quantity          Int
  quantityRemaining Int
  worth             Float?
  currency          String?
  country           String?
  website           String?
  expiryDate        DateTime?
  dealType          String?
  conditions        String?
  collectionAddress String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([creatorEmail])
  @@index([collectionAddress])
  @@map("deals")
}

// Better Auth Models
model User {
  id                    String               @id @default(cuid())
  name                  String
  email                 String               @unique
  emailVerified         Boolean              @default(false)
  image                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  sessions              Session[]
  accounts              Account[]
  workflows             Workflow[]
  credentials           Credential[]
  googleOAuthToken      GoogleOAuthToken?
  workflowGenerations   WorkflowGeneration[]
  userConnections       UserConnection[]
  subscriptionStatus    String?              // "active", "expired", "canceled", "trial", null
  subscriptionPlan      String?               @default("free") // "free", "beta-tester", "pro", "enterprise", etc.
  subscriptionExpiresAt DateTime?            // When subscription expires
  polarCustomerId       String?              @unique // Polar customer ID
  rateLimitRemaining    Int                  @default(100) // For promotional plans
  rateLimitResetAt      DateTime?            // When rate limit resets
  subscriptionFeatures  String[]             @default([]) // Array of feature IDs user has access to
  manualPayments        ManualPayment[]
  externalIdentities    ExternalIdentity[]
  chatIntegrations      ChatIntegration[]
  skills                UserSkill[]
  referralCode          String?              @unique
  referredBy            String?
  referralsMade         Referral[]           @relation("Referrals")
  referredByReferral    Referral?            @relation("ReferredBy")
  knowledgeBases        KnowledgeBase[]
  supportAgents         SupportAgent[]
  supportChannels       SupportChannel[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// @encrypted
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Credential {
  id        String   @id @default(cuid())
  name      String
  /// @encrypted
  value     String
  type      String // Changed from enum to String to support custom types
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  Node Node[]

  @@index([type])
  @@index([userId, type])
}

model GoogleOAuthToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// @encrypted
  accessToken  String
  /// @encrypted
  refreshToken String?
  expiresAt    DateTime?
  scope        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([userId])
  @@index([expiresAt])
}

model Workflow {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodes            Node[]
  connections      Connection[]
  plans            WorkflowPlan[]  // One per workflow; scoped by chatIntegrationId for chat channels
  executionHistory ExecutionHistory[]
  templates        WorkflowTemplate[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workflows")
}

// Public chat runs: store result for shareable chat (poll until completed)
model PublicChatRun {
  id          String    @id @default(cuid())
  workflowId  String
  status      String    // PENDING | RUNNING | COMPLETED | FAILED
  input       Json?     // { message?, image? }
  output      Json?     // final context or selected response
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
  @@map("public_chat_runs")
}

model WorkflowTemplate {
  id               String   @id @default(cuid())
  name             String   // Template title (descriptive, keyword-rich)
  shortDescription String   // Short description of the workflow
  howItWorks       String   // How it works, specificity, requirements (API keys, credentials, etc.)
  requirements     String?  // Required API keys, credentials, etc.
  pricing          String   @default("Free") // Explicitly "Free" for now
  category         String   // e.g. "Automation", "Marketing", "DevOps"
  creatorUserId    String
  creatorUsername  String   // Denormalized for display
  workflowId       String
  workflow         Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowSnapshot Json     // { nodes, connections } at export time
  downloadCount    Int      @default(0) // Number of times imported (downloaded)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([creatorUserId])
  @@index([workflowId])
  @@index([category])
  @@index([name])
  @@map("workflow_templates")
}

enum NodeType {
  INITIAL
  MANUAL_TRIGGER
  MANUAL_INPUT
  TIMED_TRIGGER
  HTTP_REQUEST
  WEBHOOK
  GOOGLE_FORM_TRIGGER
  STRIPE_TRIGGER
  ANTHROPIC
  GEMINI
  OPENAI
  DISCORD
  SLACK
  WHATSAPP_TRIGGER
  WHATSAPP
  TELEGRAM_TRIGGER
  TELEGRAM
  DECIDER
  GOOGLE_DRIVE
  GOOGLE_CALENDAR
  GOOGLE_SHEETS
  GOOGLE_DOCS
  GOOGLE_MEET
  GOOGLE_SLIDES
  GMAIL
  AIRTABLE
  AIRTABLE_TRIGGER
  CODE_BLOCK
  PLAN
  DESIGN
  DESIGN_PRO
  LOYALTY_DEAL
  LOYALTY_PROGRAM
  REMOTION
  VEO
  KLING_TEXT2VIDEO
  KLING_IMAGE2VIDEO
  KLING_IMAGE
  KLING_TTS
  KLING_OMNI_VIDEO
  KLING_OMNI_IMAGE
  KLING_VIDEO_EXTEND
  KLING_MULTI_IMAGE2VIDEO
  KLING_MOTION_CONTROL
  KLING_MULTI_IMAGE2IMAGE
  OUTPUT
  MARKDOWN
  SEEDANCE
  SEEDREAM
  COMPOSIO_ACTION
  COMPOSIO_TRIGGER
  TINYFISH
  AGENT_TEAM
  VALYU_SEARCH
  VALYU_CONTENTS
  VALYU_ANSWER
  VALYU_DEEP_RESEARCH
}

model ComposioWebhookSubscription {
  id             String   @id @default(cuid())
  scope          String   @unique @default("global")
  subscriptionId String?
  webhookUrl     String?
  secret         String?
  enabled        Boolean  @default(true)
  enabledEvents  Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("composio_webhook_subscriptions")
}

model Node {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name     String
  type     NodeType
  position Json
  data     Json     @default("{}")

  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outputConnections Connection[] @relation("FromNode")
  inputConnections  Connection[] @relation("ToNode")
  assets            NodeAsset[] // Assets stored separately to avoid transaction timeouts

  @@index([workflowId])
  @@map("nodes")
}

model NodeAsset {
  id     String @id @default(cuid())
  nodeId String
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  filename          String
  fileType          String // "image" | "video" | "audio"
  fileData          String // base64 data URL or URL
  sceneDescription  String?
  startTime         Float?
  position          Json? // { x?: number, y?: number }
  size              Json? // { width?: number, height?: number }
  isBackgroundAudio Boolean @default(false)
  volume            Float? // For background audio

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nodeId])
  @@map("node_assets")
}

model Connection {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  fromNodeId String
  fromNode   Node   @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)

  toNodeId String
  toNode   Node   @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  fromOutput String @default("main")
  toInput    String @default("main")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromNodeId, toNodeId, fromOutput, toInput])
  @@index([workflowId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@map("connections")
}

model WorkflowGeneration {
  id                String   @id @default(cuid())
  userId            String
  workflowId        String?
  prompt            String
  generatedWorkflow Json // Stores the generated workflow blueprint (nodes + connections)
  customCodeBlocks  Json? // Stores custom code for CODE_BLOCK nodes
  status            String   @default("pending") // pending, generating, testing, completed, failed
  testResults       Json? // Stores test results from Daytona sandboxes
  daytonaSandboxIds String[] // Array of Daytona sandbox IDs used for testing/execution
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workflowId])
  @@index([status])
  @@map("workflow_generations")
}

model WorkflowPlan {
  id                   String   @id @default(cuid())
  workflowId           String
  chatIntegrationId    String?  // null = canvas/standalone; set = per-integration plan (prevents personality leak)
  workflow             Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  conversationHistory  String   @default("[]")
  status               String   @default("planning") // planning, ready, generating, completed
  generatedPrompt      String?
  workflowStructure    Json? // Proposed workflow structure
  approvedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowId, chatIntegrationId])
  @@index([workflowId])
  @@map("workflow_plans")
}

// ============================================
// User Connections (MCP Servers, Data Sources)
// ============================================

enum UserConnectionType {
  MCP_SERVER // External MCP server connection (Supabase, Notion, etc.)
  DATABASE // Direct database connection via MCP
  DOCUMENTATION // API docs, guides, references (OpenAPI specs, markdown)
  API_ENDPOINT // REST/GraphQL API documentation
}

model UserConnection {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  type         UserConnectionType
  config       Json // MCP config, connection string, server URL, etc.
  metadata     Json? // Additional info: schema, docs content, capabilities
  isActive     Boolean            @default(true)
  lastUsedAt   DateTime?
  lastTestedAt DateTime?
  testStatus   String? // "success", "failed", "pending"
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId])
  @@index([type])
  @@index([isActive])
  @@map("user_connections")
}

// ============================================
// Agent Learning and Execution History
// ============================================

model ExecutionHistory {
  id           String   @id @default(cuid())
  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executionId  String   @unique // Inngest execution ID
  success      Boolean
  duration     Int // Duration in milliseconds
  nodeMetrics  Json // Performance data per node
  errorContext Json? // Error details if failed
  learnings    Json? // Extracted patterns/insights
  userFeedback String? // Optional user feedback
  createdAt    DateTime @default(now())

  @@index([workflowId])
  @@index([success])
  @@index([createdAt])
  @@map("execution_history")
}

model WorkflowPattern {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String? // e.g., "Marketing", "DevOps", "Data Pipeline"
  pattern     Json // Node structure, connections template
  tags        String[]
  useCount    Int      @default(0)
  successRate Float    @default(0)
  isTemplate  Boolean  @default(false) // If true, shown in template library
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([tags])
  @@index([isTemplate])
  @@map("workflow_patterns")
}

model ManualPayment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String   @default("USD")
  paymentMethod String // "bank_transfer", "wire", "check", etc.
  paymentProof String? // URL or reference to proof document
  status      String   // "pending", "verified", "rejected", "completed"
  polarOrderId String? // Polar order ID once created
  verifiedBy  String?  // Admin user ID who verified
  verifiedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("manual_payments")
}

// ============================================
// External Identity Mapping (Chat Integrations, Telegram, etc.)
// ============================================

model ExternalIdentity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationId   String?
  integration     ChatIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  platform        String   // "telegram", "discord", "slack", etc.
  externalId      String   // Platform-specific user ID (e.g., Telegram sender ID)
  externalName    String?  // Display name from the platform
  metadata        Json?    // Additional platform-specific data
  linkedAt        DateTime @default(now())
  lastActiveAt    DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([platform, externalId, integrationId])
  @@index([userId])
  @@index([integrationId])
  @@index([platform])
  @@index([externalId])
  @@map("external_identities")
}

// ============================================
// Chat Integration Settings
// ============================================

model ChatIntegration {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String   @default("Chat Integration") // User-defined label
  platform        ChatPlatform @default(TELEGRAM)
  scope           ChatScope    @default(ALL_WORKFLOWS)
  scopeWorkflowId String?  // Workflow ID for SINGLE_WORKFLOW scope
  allowedWorkflowIds String[] @default([]) // Workflow IDs for ALLOW_LIST scope
  /// @encrypted
  sharedSecret    String   // Secret for authenticating incoming requests
  /// @encrypted
  telegramBotToken String? // Optional Telegram bot token for guided setup
  telegramBotUsername String?  // Bot username (without @), fetched via getMe
  telegramBotId      String?  // Bot's Telegram user ID (for reply detection in groups)
  isActive        Boolean  @default(true)
  webhookUrl      String?  // Generated webhook URL for external services to call
  defaultWorkflowId String? // Optional default workflow to use
  lastRunWorkflowId String? // Last workflow run via chat integration
  allowPlanMode   Boolean  @default(true) // Allow plan mode interactions
  allowWorkflowExecution Boolean @default(true) // Allow direct workflow execution
  externalIdentities ExternalIdentity[]
  lastUsedAt      DateTime?
  totalRequests   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  whatsappSessionId String?  @unique
  whatsappSession   WhatsAppSession? @relation(fields: [whatsappSessionId], references: [id], onDelete: SetNull)
  /// When true (default), only messages from the connected number (owner) trigger the agent. When false, anyone who messages the number can chat (customer support).
  whatsappOnlyOwnerCanChat Boolean @default(true)

  // Slack fields
  /// @encrypted
  slackBotToken       String?  // xoxb-... Bot User OAuth Token
  /// @encrypted
  slackSigningSecret  String?  // Slack app signing secret for request verification
  slackTeamId         String?  // Workspace/team ID
  slackBotUserId      String?  // Bot's own user ID (to ignore self-messages)

  // Discord fields
  /// @encrypted
  discordBotToken     String?  // Discord bot token
  discordClientId     String?  // Application ID (for invite URL)
  discordGuildId      String?  // Server/guild ID (optional, for scoping)
  discordBotUserId    String?  // Bot's own user ID (to ignore self-messages)

  // Agent personality (soul.md)
  soulMd             String?  @db.Text  // Personality markdown (soul.md content)
  evolvePersonality  Boolean  @default(false) // Allow agent to refine its own soul over time

  // Skill access
  skillScope         SkillScope @default(ALL_SKILLS) // ALL_SKILLS | SELECTED_SKILLS | NO_SKILLS
  allowedSkillIds    String[] @default([]) // Skill IDs when skillScope is SELECTED_SKILLS

  @@index([userId])
  @@index([platform])
  @@index([scope])
  @@index([whatsappSessionId])
  @@map("chat_integrations")
}

// ============================================
// WhatsApp (Baileys) session state
// ============================================

model WhatsAppSession {
  id             String   @id @default(cuid())
  integrationId  String?  @unique // ChatIntegration.id when used for chat integration
  credentialId   String?  @unique // Credential.id when used for workflow Send/Trigger nodes
  authState      Json?    // Baileys auth state (serialized). Rely on DB encryption at rest for production.
  status         String   @default("disconnected") // disconnected | connecting | open | qr
  phoneNumber    String?  // Last known number for display
  workerId       String?  // Connector instance that owns this session (for sharding)
  lastUsedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chatIntegration ChatIntegration?
  supportChannels SupportChannel[] @relation("SupportChannelWhatsAppSession")

  @@index([status])
  @@index([workerId])
  @@map("whatsapp_sessions")
}

enum ChatPlatform {
  TELEGRAM
  WHATSAPP
  DISCORD
  SLACK
}

enum ChatScope {
  SINGLE_WORKFLOW
  ALL_WORKFLOWS
  ALLOW_LIST
}

enum SkillScope {
  ALL_SKILLS     // Agent has access to all user custom skills
  SELECTED_SKILLS // Agent has access only to selected skills
  NO_SKILLS      // Agent has no custom skills
}

model UserSkill {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  url         String?
  content     String   // Full markdown content
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, name])
  @@map("user_skills")
}

// ============================================
// Chat Conversation (per-sender isolation)
// ============================================

model ChatConversation {
  id                  String   @id @default(cuid())
  chatIntegrationId   String
  externalId          String
  conversationHistory String   @default("[]")
  lastMessageAt       DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([chatIntegrationId, externalId])
  @@index([chatIntegrationId])
  @@map("chat_conversations")
}

// ============================================
// Referral Program
// ============================================

model Referral {
  id              String    @id @default(cuid())
  referrerId      String
  referrer        User      @relation("Referrals", fields: [referrerId], references: [id])
  referredUserId  String?   @unique
  referredUser    User?     @relation("ReferredBy", fields: [referredUserId], references: [id])
  code            String    @unique
  clicks          Int       @default(0)
  status          String    @default("pending")
  commissionType  String    @default("credits")
  commissionValue Float     @default(500)
  totalEarned     Float     @default(0)
  convertedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

// ============================================
// Support Agent (KB-based support + public chat/widget)
// ============================================

model SupportAgent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  description     String?

  // Public identifier for shareable chat URL and embeds
  publicId        String   @unique @default(cuid())

  // Assigned knowledge bases (support answers are restricted to these)
  knowledgeBaseIds String[] @default([])

  // Fallback contact email when KB cannot answer confidently
  fallbackEmail   String?

  // Optional styling / placement for future widget embeds
  greeting        String   @default("Hi! How can I help you?")
  brandColor      String   @default("#6366f1")
  position        String   @default("bottom-right")
  avatarUrl       String?
  allowedDomains  String[]

  status          String   @default("active")
  conversations   Int      @default(0)

  // SDR mode: support (default) | sdr
  mode            String   @default("support")

  // Attached skills (for support + SDR)
  skillIds        String[] @default([])

  // Optional personality for SDR
  soulMd          String?  @db.Text

  // Campaign/post content (paste)
  campaignContext String?  @db.Text

  // User-defined funnel triggers and behaviors
  funnelRules     Json?

  chatSessions    SupportChatSession[]
  channels        SupportChannel[]
  supportContacts SupportContact[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("support_agents")
}

// Support channel configuration (per agent, per external platform)
model SupportChannel {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  supportAgentId String
  supportAgent   SupportAgent @relation(fields: [supportAgentId], references: [id], onDelete: Cascade)

  platform       ChatPlatform
  status         String   @default("pending") // pending | connected | disabled

  // Optional WhatsApp session link when platform = WHATSAPP
  whatsappSessionId String?
  whatsappSession   WhatsAppSession? @relation("SupportChannelWhatsAppSession", fields: [whatsappSessionId], references: [id], onDelete: SetNull)

  // Optional Telegram config when platform = TELEGRAM
  telegramBotToken String?
  telegramChatId   String?

  // Optional Slack config when platform = SLACK
  slackBotToken      String?
  slackSigningSecret String?
  slackTeamId        String?
  slackChannelId     String?

  // Optional Discord config when platform = DISCORD
  discordBotToken  String?
  discordGuildId   String?
  discordChannelId String?

  supportContacts SupportContact[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([supportAgentId])
  @@index([platform])
  @@index([whatsappSessionId])
  @@map("support_channels")
}

// Support contact: someone who messaged the agent via a channel (WhatsApp, Telegram)
model SupportContact {
  id                 String   @id @default(cuid())
  supportAgentId     String
  supportAgent       SupportAgent @relation(fields: [supportAgentId], references: [id], onDelete: Cascade)
  supportChannelId   String
  supportChannel     SupportChannel @relation(fields: [supportChannelId], references: [id], onDelete: Cascade)
  platform           String   // "WHATSAPP" | "TELEGRAM"
  externalId         String   // JID for WhatsApp, user id for Telegram
  externalName       String?  // pushName / display name
  phone              String?  // normalized phone (WhatsApp); Telegram typically has none
  metadata           Json?    // optional: username for Telegram, etc.
  firstContactAt     DateTime @default(now())
  lastContactAt     DateTime @default(now())

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([supportAgentId, supportChannelId, platform, externalId])
  @@index([supportAgentId])
  @@index([supportChannelId])
  @@map("support_contacts")
}

// Per-visitor support chat session (publicSessionId = client localStorage sessionId)
model SupportChatSession {
  id                String               @id @default(cuid())
  supportAgentId    String
  supportAgent      SupportAgent         @relation(fields: [supportAgentId], references: [id], onDelete: Cascade)
  publicSessionId   String
  createdAt         DateTime             @default(now())
  lastMessageAt    DateTime             @default(now())
  rating            Int?                 // 1-5 from customer
  feedback          String?              @db.Text // optional improvement suggestion
  suggestRating     Boolean             @default(false) // agent signaled conversation complete → show rating
  flowState         Json?
  messages         SupportChatMessage[]

  @@unique([supportAgentId, publicSessionId])
  @@index([supportAgentId])
  @@map("support_chat_sessions")
}

model SupportChatMessage {
  id                   String              @id @default(cuid())
  supportChatSessionId String
  supportChatSession   SupportChatSession  @relation(fields: [supportChatSessionId], references: [id], onDelete: Cascade)
  role                 String              // "user" | "assistant"
  content              String              @db.Text
  attachmentUrls       Json?               // [{ type, url }]
  hadFallbackReply     Boolean             @default(false)
  createdAt            DateTime            @default(now())

  @@index([supportChatSessionId])
  @@map("support_chat_messages")
}

// ============================================
// Knowledge Base / RAG
// ============================================

model KnowledgeBase {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String              @default("active")
  documents   KnowledgeDocument[]
  chunks      KnowledgeChunk[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  title           String
  sourceType      String
  sourceUrl       String?
  content         String
  status          String        @default("processing")
  chunkCount      Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  chunks          KnowledgeChunk[]

  @@index([knowledgeBaseId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id              String           @id @default(cuid())
  documentId      String
  knowledgeBaseId String
  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  content         String
  chunkIndex      Int
  embedding       Unsupported("vector")
  createdAt       DateTime         @default(now())

  @@index([documentId])
  @@index([knowledgeBaseId])
  @@index([knowledgeBaseId, chunkIndex])
  @@map("knowledge_chunks")
}
