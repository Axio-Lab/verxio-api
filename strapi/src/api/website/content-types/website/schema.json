{
  "kind": "collectionType",
  "collectionName": "websites",
  "info": {
    "singularName": "website",
    "pluralName": "websites",
    "displayName": "Website",
    "description": "Multi-page websites, funnels, and blogs created via Verxio"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "userId": {
      "type": "string",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "published"],
      "default": "draft",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": ["website", "funnel", "blog"],
      "default": "website",
      "required": true
    },
    "navigation": {
      "type": "json"
    },
    "globalStyles": {
      "type": "json"
    },
    "customDomain": {
      "type": "string"
    },
    "domainVerified": {
      "type": "boolean",
      "default": false
    },
    "pages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page.page",
      "mappedBy": "website"
    },
    "blogPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-post.blog-post",
      "mappedBy": "website"
    }
  }
}
