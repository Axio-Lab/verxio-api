{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Individual pages belonging to a website"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "userId": {
      "type": "string",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "published"],
      "default": "draft",
      "required": true
    },
    "pageType": {
      "type": "enumeration",
      "enum": [
        "landing",
        "about",
        "contact",
        "checkout",
        "thankyou",
        "upsell",
        "downsell",
        "form",
        "blog-listing",
        "custom"
      ],
      "default": "landing",
      "required": true
    },
    "sections": {
      "type": "json",
      "required": true
    },
    "seo": {
      "type": "json"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "nextPageSlug": {
      "type": "string"
    },
    "website": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::website.website",
      "inversedBy": "pages"
    }
  }
}
